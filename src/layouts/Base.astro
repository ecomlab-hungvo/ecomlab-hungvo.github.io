---
/* Every page: head (bilingual title, description, Open Graph), header, footer, shared scripts.
   English is the default text; Vietnamese lives in data-title-vi / data-desc-vi and the language switch swaps them. */
interface Props {
  titleEn: string; titleVi: string;
  descEn: string; descVi: string;
  path: string;              // URL path without the domain: '' for home, 'about.html', 'lesson-1-1.html'
  noDark?: boolean;          // lesson pages stay light
  before?: string[];         // scripts that must load before main.js (agenda)
  after?: string[];          // scripts after theme.js (data, sim, feedback)
}
const { titleEn, titleVi, descEn, descVi, path, noDark = false, before = [], after = [] } = Astro.props;
const site = 'https://ecomlab-hungvo.github.io/';
const url = site + path;
const headScript = "(function(){var l='en';try{l=localStorage.getItem('ecomlab-lang')||'en'}catch(e){}if(l!=='vi')l='en';var h=document.documentElement;h.lang=l;h.dataset.lang=l;h.classList.add('js');if(!h.hasAttribute('data-no-dark')){var t=null;try{t=localStorage.getItem('ecomlab-theme')}catch(e){}if(t!=='light'&&t!=='dark')t=window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';h.dataset.theme=t}})();";
const nav = [
  { href: '/about.html', en: 'About', vi: 'Giới thiệu' },
  { href: '/courses.html', en: 'Courses', vi: 'Khoá học' },
  { href: '/resources.html', en: 'Resources', vi: 'Tài nguyên' }
];
---
<!doctype html>
<html lang="en" data-lang="en" data-no-dark={noDark ? '' : undefined} data-title-vi={titleVi} data-desc-vi={descVi}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{titleEn}</title>
<meta name="description" content={descEn}>
<link rel="canonical" href={url}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Ecom LAB">
<meta property="og:title" content={titleEn}>
<meta property="og:description" content={descEn}>
<meta property="og:url" content={url}>
<!-- TODO: replace with a 1200x630 share image -->
<meta property="og:image" content="https://ecomlab-hungvo.github.io/assets/img/hung-profile.webp">
<meta property="og:locale" content="en_US">
<meta property="og:locale:alternate" content="vi_VN">
<meta name="twitter:card" content="summary">
<script is:inline set:html={headScript}></script>
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
<a class="skip" href="#main"><span data-l="en">Skip to main content</span><span data-l="vi">Đi tới nội dung chính</span></a>

<header class="site-header">
  <div class="container">
    <a class="logo" href="/index.html" aria-label="Ecom LAB"><span class="logo-mark" aria-hidden="true"></span><span class="logo-text">Ecom LAB</span></a>
    <nav class="nav" aria-label="Main" data-aria-vi="Điều hướng chính">
      {nav.map(n => <a href={n.href}><span data-l="en">{n.en}</span><span data-l="vi">{n.vi}</span></a>)}
    </nav>
    <div class="lang" role="group" aria-label="Language" data-aria-vi="Ngôn ngữ">
      <button type="button" data-set-lang="vi">VI</button>
      <button type="button" data-set-lang="en">EN</button>
    </div>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" data-aria-vi="Chuyển sang nền tối"><svg class="tt-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><svg class="tt-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg></button>
  </div>
</header>

<slot />

<footer class="footer on-dark">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="logo" href="/index.html" aria-label="Ecom LAB"><span class="logo-mark" aria-hidden="true"></span><span class="logo-text">Ecom LAB</span></a>
        <p data-l="en">What happens behind every order.</p>
        <p data-l="vi">Điều gì diễn ra phía sau mỗi đơn hàng.</p>
      </div>
      <div class="footer-links">
        <h2><span data-l="en">Explore</span><span data-l="vi">Khám phá</span></h2>
        {nav.map(n => <a href={n.href}><span data-l="en">{n.en}</span><span data-l="vi">{n.vi}</span></a>)}
      </div>
      <div class="footer-links">
        <h2><span data-l="en">Connect</span><span data-l="vi">Kết nối</span></h2>
        <a href="https://www.linkedin.com/in/hungvo1803" rel="noopener">LinkedIn</a>
        <a href="https://github.com/ecomlab-hungvo" rel="noopener">GitHub</a>
      </div>
    </div>
    <p class="footer-note"><span>© 2026 Hùng Võ · Ecom LAB. </span><span data-l="en">Disclaimer: Views are my own, not any employer's. Ecom LAB is not affiliated with any marketplace. Content is for education only and is not professional advice.</span><span data-l="vi">Miễn trừ trách nhiệm: Quan điểm là của riêng mình, không đại diện cho công ty nào. Ecom LAB không liên kết với sàn nào. Nội dung chỉ nhằm mục đích học tập, không phải tư vấn chuyên môn.</span></p>
  </div>
</footer>
<slot name="before-scripts" />
{before.map(s => <script is:inline src={`/assets/js/${s}.js`}></script>)}
<script is:inline src="/assets/js/main.js"></script>
<script is:inline src="/assets/js/theme.js"></script>
{after.map(s => <script is:inline src={`/assets/js/${s}.js`}></script>)}
</body>
</html>

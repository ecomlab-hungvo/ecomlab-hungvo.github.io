---
interface Props { title_en: string; title_vi: string; why_en?: string; why_vi?: string }
const { title_en, title_vi, why_en, why_vi } = Astro.props;
---
<li>
  <p class="ai-step-title"><span data-l="en">{title_en}</span><span data-l="vi">{title_vi}</span></p>
  {why_en && <p class="ai-step-why"><span data-l="en">{why_en}</span><span data-l="vi">{why_vi}</span></p>}
  <slot />
</li>
